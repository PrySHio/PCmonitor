<UserControl x:Class="PcMonitor.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcMonitor.Controls"
             Loaded="OnLoaded">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}" />
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}" />
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource BigValue}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,4,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок и действия -->
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="История измерений" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding RangeText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border CornerRadius="9" Padding="11,5" Margin="0,0,12,0" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding DbInfo}" Foreground="{DynamicResource AccentBrush}"
                               FontSize="12.5" FontWeight="SemiBold" />
                </Border>
                <Button Content="Обновить" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="Очистить" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <!-- Ошибки базы данных -->
        <Border Grid.Row="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" TextTrimming="None" />
        </Border>

        <!-- Период и показатель -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding Periods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="HistoryPeriod" Style="{StaticResource Pill}"
                                     Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="HistoryMetric" Style="{StaticResource Pill}"
                                     Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Сводка -->
        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,-16,0">
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Среднее" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Average}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Максимум" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Maximum}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Минимум" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Minimum}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Записей за период" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Records}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- График -->
        <Border Grid.Row="4" Style="{StaticResource Card}" MinHeight="260">
            <Grid>
                <c:LineChart Series="{Binding Series}" MaxPoints="160" XLabels="{Binding XLabels}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLoaded}" Value="True" />
                                        <Condition Binding="{Binding HasData}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Нет данных за выбранный период" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Записи появятся, когда приложение поработает с включённой историей. Показатели, недоступные на этом ПК, не сохраняются."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="440" TextTrimming="None" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
