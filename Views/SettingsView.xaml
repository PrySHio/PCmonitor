<UserControl x:Class="PcMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcMonitor.Services">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}" />
        </EventTrigger>
    </UserControl.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="32,4,26,16" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{l:Tr Nav_Settings}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Settings_Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPalette}" Fill="{DynamicResource AccentBrush}" Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="{l:Tr Settings_Appearance}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="{l:Tr Settings_ThemeHint}" Style="{StaticResource Muted}" Margin="0,4,0,16" />
                <ItemsControl ItemsSource="{Binding Themes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Theme" Style="{StaticResource ThemeSwatch}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Язык интерфейса -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconLanguage}" Fill="{DynamicResource GpuBrush}" Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="{l:Tr Settings_Language}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="{l:Tr Settings_LanguageHint}" Style="{StaticResource Muted}" Margin="0,4,0,16" />
                <ItemsControl ItemsSource="{Binding Languages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Language" Style="{StaticResource Pill}"
                                         Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconClock}" Fill="{DynamicResource CpuBrush}" Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="{l:Tr Settings_Monitoring}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Settings_Interval}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_IntervalHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Style="{StaticResource ModernSlider}" Width="240" Minimum="1" Maximum="10"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding IntervalSeconds, Mode=TwoWay}" />
                        <TextBlock Text="{Binding IntervalText}" Width="78" TextAlignment="Right"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{l:Tr Settings_SaveHistory}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_SaveHistoryHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding SaveHistory, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Settings_HistoryPeriod}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_HistoryPeriodHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Style="{StaticResource ModernSlider}" Width="240" Minimum="1" Maximum="60"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HistoryIntervalSeconds, Mode=TwoWay}" />
                        <TextBlock Text="{Binding HistoryIntervalText}" Width="78" TextAlignment="Right"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Settings_Retention}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_RetentionHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Style="{StaticResource ModernSlider}" Width="240" Minimum="1" Maximum="90"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RetentionDays, Mode=TwoWay}" />
                        <TextBlock Text="{Binding RetentionText}" Width="78" TextAlignment="Right"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBell}" Fill="{DynamicResource WarningBrush}" Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="{l:Tr Settings_Notifications}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <Grid Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{l:Tr Settings_NotifyEnabled}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_NotifyEnabledHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
                </Grid>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationsEnabled}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                <Grid Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{l:Tr Settings_Sound}" FontWeight="Medium" />
                            <TextBlock Text="{l:Tr Settings_SoundHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding NotificationSound, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Settings_CpuLoad}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_Threshold}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Style="{StaticResource ModernSlider}" Width="240" Minimum="50" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CpuThreshold, Mode=TwoWay}" />
                        <TextBlock Text="{Binding CpuThreshold, StringFormat={}{0} %}" Width="78" TextAlignment="Right"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Settings_RamUsage}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_Threshold}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Style="{StaticResource ModernSlider}" Width="240" Minimum="50" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RamThreshold, Mode=TwoWay}" />
                        <TextBlock Text="{Binding RamThreshold, StringFormat={}{0} %}" Width="78" TextAlignment="Right"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Settings_GpuLoad}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_Threshold}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Style="{StaticResource ModernSlider}" Width="240" Minimum="50" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GpuThreshold, Mode=TwoWay}" />
                        <TextBlock Text="{Binding GpuThreshold, StringFormat={}{0} %}" Width="78" TextAlignment="Right"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Settings_Temp}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_TempHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Style="{StaticResource ModernSlider}" Width="240" Minimum="50" Maximum="110"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TempThreshold, Mode=TwoWay}" />
                        <TextBlock Text="{Binding TempThresholdText}" Width="78" TextAlignment="Right"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Settings_Cooldown}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_CooldownHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Style="{StaticResource ModernSlider}" Width="240" Minimum="1" Maximum="60"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NotifyCooldownMinutes, Mode=TwoWay}" />
                        <TextBlock Text="{Binding CooldownText}" Width="78" TextAlignment="Right"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                    <Button Content="{l:Tr Settings_ShowTest}" Style="{StaticResource GhostButton}"
                            Command="{Binding ShowTestCommand}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDashboard}" Fill="{DynamicResource GpuBrush}" Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="{l:Tr Settings_App}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <Grid Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                        <TextBlock Text="{l:Tr Settings_CloseToTray}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_CloseToTrayHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                        <TextBlock Text="{l:Tr Settings_MinToTray}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_MinToTrayHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                        <TextBlock Text="{l:Tr Settings_Autostart}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_AutostartHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                </Grid>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LaunchAtStartup}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                <Grid Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                        <TextBlock Text="{l:Tr Settings_StartInTray}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_StartInTrayHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding StartInTray, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                        <TextBlock Text="{l:Tr Settings_RunAdmin}" FontWeight="Medium" />
                        <TextBlock Text="{l:Tr Settings_RunAdminHint}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding RunAsAdmin, Mode=TwoWay}" />
                </Grid>
                </StackPanel>
                <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Muted}" Margin="0,16,0,0"
                           TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
        </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Панель действий -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="32,14">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Tr Settings_Reset}" Style="{StaticResource GhostButton}" Command="{Binding ResetCommand}" Margin="0,0,10,0" />
                    <Button Content="{l:Tr Settings_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
