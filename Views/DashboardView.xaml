<UserControl x:Class="PcMonitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PcMonitor.Services"
             xmlns:c="clr-namespace:PcMonitor.Controls"
             xmlns:m="clr-namespace:PcMonitor.Models">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}" />
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Строка температуры: DataContext = MetricCardViewModel -->
        <DataTemplate x:Key="TempRow">
            <StackPanel Margin="0,16,0,0">
                <Grid>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ValueText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="FontSize" Value="20" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontFamily" Value="{StaticResource AppFontDisplay}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Setter Property="FontSize" Value="15" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static m:Level.Warning}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static m:Level.Critical}">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Muted}" Margin="4,0,0,2" VerticalAlignment="Bottom" />
                    </StackPanel>
                </Grid>
                <ProgressBar Value="{Binding BarValue}" Maximum="110" Margin="0,8,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource SlimProgress}">
                            <Setter Property="Foreground" Value="{DynamicResource TempBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static m:Level.Warning}">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static m:Level.Critical}">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap">
                    <TextBlock.Visibility>
                        <Binding Path="IsAvailable">
                            <Binding.Converter>
                                <c:InverseBoolToVisibilityConverter />
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Диск: DataContext = DiskItemViewModel -->
        <DataTemplate x:Key="DiskRow">
            <StackPanel Margin="0,0,0,18">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Percent, StringFormat={}{0:0} %}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
                <ProgressBar Value="{Binding Percent}" Margin="0,8,0,6">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource SlimProgress}">
                            <Setter Property="Foreground" Value="{DynamicResource DiskBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static m:Level.Warning}">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static m:Level.Critical}">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <Grid>
                    <TextBlock Text="{Binding UsedText}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding FreeText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="32,4,26,32">

            <!-- Заголовок страницы -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{l:Tr Dash_Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="9" Padding="11,5"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource AccentBrush}"
                               FontSize="12.5" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <!-- Предупреждение о превышении порога -->
            <Border CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                    Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding HasAlert, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBell}" Fill="{DynamicResource DangerBrush}"
                          Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AlertText}" Foreground="{DynamicResource DangerBrush}"
                               FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Основные карточки -->
            <UniformGrid Columns="3" Margin="0,0,-16,0">
                <c:MetricCard DataContext="{Binding Cpu}" Icon="{StaticResource IconCpu}"
                              Accent="{DynamicResource CpuBrush}" MinHeight="228" Margin="0,0,16,16" />
                <c:MetricCard DataContext="{Binding Ram}" Icon="{StaticResource IconRam}"
                              Accent="{DynamicResource RamBrush}" MinHeight="228" Margin="0,0,16,16" />
                <c:MetricCard DataContext="{Binding Gpu}" Icon="{StaticResource IconGpu}"
                              Accent="{DynamicResource GpuBrush}" MinHeight="228" Margin="0,0,16,16" />
            </UniformGrid>

            <!-- Температуры и диски -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTemp}" Fill="{DynamicResource TempBrush}"
                                  Width="20" Height="20" Stretch="Uniform" />
                            <TextBlock Text="{l:Tr Dash_Temps}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                        </StackPanel>
                        <ContentControl Content="{Binding CpuTemp}" ContentTemplate="{StaticResource TempRow}" />
                        <ContentControl Content="{Binding GpuTemp}" ContentTemplate="{StaticResource TempRow}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Path Data="{StaticResource IconDisk}" Fill="{DynamicResource DiskBrush}"
                                  Width="20" Height="20" Stretch="Uniform" />
                            <TextBlock Text="{l:Tr Dash_Disks}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource DiskRow}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Общий график -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{l:Tr Dash_LoadMinute}" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource CpuBrush}" />
                            <TextBlock Text="{l:Tr Metric_Cpu}" Style="{StaticResource Muted}" Margin="6,0,16,0" />
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource RamBrush}" />
                            <TextBlock Text="{l:Tr Metric_Ram}" Style="{StaticResource Muted}" Margin="6,0,16,0" />
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource GpuBrush}" />
                            <TextBlock Text="{l:Tr Metric_Gpu}" Style="{StaticResource Muted}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <c:LineChart Height="230" MaxPoints="60" Series="{Binding Overview}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
